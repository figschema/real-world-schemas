        datetime delivered_at
        datetime opened_at
        datetime clicked_at
        tinyint(1) track_opens
        tinyint(1) track_clicks
        datetime created_at
        datetime updated_at
    }
    automation_action_edges {
        varchar(24) source_action_id PK
        varchar(24) target_action_id PK
    }
    automation_action_revisions {
        varchar(24) id PK
