%% Diagrammed with FigSchema
erDiagram
    actions {
        varchar(24) id PK
        varchar(24) resource_id
        varchar(50) resource_type
        varchar(24) actor_id
        varchar(50) actor_type
        varchar(50) event
        text context
        datetime created_at
    }
    api_keys {
        varchar(24) id PK
        varchar(50) type
        varchar(191) secret UK
        varchar(24) role_id
        varchar(24) integration_id
        varchar(24) user_id
        datetime last_seen_at
        varchar(50) last_seen_version
        datetime created_at
        datetime updated_at
    }
    automated_email_recipients {
        varchar(24) id PK
        varchar(24) automated_email_id FK
        varchar(24) automation_action_revision_id FK
        varchar(24) automation_run_step_id FK
        varchar(24) member_id
