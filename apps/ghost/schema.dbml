  feature_image_caption text
  custom_excerpt varchar(2000)
}

Table posts {
  id varchar(24) [pk, unique]
  uuid varchar(36) [not null]
  title varchar(2000) [not null]
  slug varchar(191) [unique, not null]
  mobiledoc longtext
  lexical longtext
  html longtext
  comment_id varchar(50)
  plaintext longtext
  feature_image varchar(2000)
  featured tinyint(1) [not null]
  type varchar(50) [unique, not null]
  status varchar(50) [not null]
  locale varchar(6)
  visibility varchar(50) [not null]
  email_recipient_filter text [not null]
  created_at datetime [not null]
  updated_at datetime
  published_at datetime
  published_by varchar(24)
  custom_excerpt varchar(2000)
  auto_excerpt varchar(500)
  reading_time int unsigned
  codeinjection_head text
  codeinjection_foot text
  custom_template varchar(100)
  canonical_url text
  newsletter_id varchar(24)
  show_title_and_feature_image tinyint(1) [not null]
}

Table posts_authors {
  id varchar(24) [pk]
  post_id varchar(24) [not null]
  author_id varchar(24) [not null]
  sort_order int unsigned [not null]
}

Table posts_meta {
  id varchar(24) [pk]
  post_id varchar(24) [unique, not null]
  og_image varchar(2000)
  og_title varchar(300)
  og_description varchar(500)
  twitter_image varchar(2000)
  twitter_title varchar(300)
  twitter_description varchar(500)
  meta_title varchar(2000)
  meta_description varchar(2000)
  email_subject varchar(300)
  frontmatter text
  feature_image_alt varchar(2000)
  feature_image_caption text
  email_only tinyint(1) [not null]
}

Table posts_products {
  id varchar(24) [pk]
  post_id varchar(24) [not null]
  product_id varchar(24) [not null]
  sort_order int unsigned [not null]
}

Table posts_tags {
  id varchar(24) [pk]
  post_id varchar(24) [not null]
  tag_id varchar(24) [not null]
  sort_order int unsigned [not null]
}

Table products {
  id varchar(24) [pk, unique]
  name varchar(191) [not null]
  slug varchar(191) [unique, not null]
  active tinyint(1) [not null]
  welcome_page_url varchar(2000)
  visibility varchar(50) [not null]
  trial_days int unsigned [not null]
  description varchar(191)
  type varchar(50) [not null]
  currency varchar(50)
  monthly_price int unsigned
  yearly_price int unsigned
  created_at datetime [not null]
  updated_at datetime
  monthly_price_id varchar(24)
  yearly_price_id varchar(24)
}

Table products_benefits {
  id varchar(24) [pk]
  product_id varchar(24) [not null]
  benefit_id varchar(24) [not null]
  sort_order int unsigned [not null]
}

Table recommendation_click_events {
  id varchar(24) [pk]
  recommendation_id varchar(24) [not null]
  member_id varchar(24)
  created_at datetime [not null]
}

Table recommendation_subscribe_events {
  id varchar(24) [pk]
  recommendation_id varchar(24) [not null]
  member_id varchar(24)
  created_at datetime [not null]
}

Table recommendations {
  id varchar(24) [pk]
  url varchar(2000) [not null]
  title varchar(2000) [not null]
  excerpt varchar(2000)
  featured_image varchar(2000)
  favicon varchar(2000)
  description varchar(2000)
  one_click_subscribe tinyint(1) [not null]
  created_at datetime [not null]
  updated_at datetime
}

Table redirects {
  id varchar(24) [pk]
  from varchar(191) [not null]
  to varchar(2000) [not null]
  post_id varchar(24)
  automation_action_revision_id varchar(24) [unique]
  to_hash varbinary(32) [unique]
  created_at datetime [not null]
  updated_at datetime
}

Table roles {
  id varchar(24) [pk]
  name varchar(50) [unique, not null]
  description varchar(2000)
  created_at datetime [not null]
  updated_at datetime
}

Table roles_users {
  id varchar(24) [pk]
  role_id varchar(24) [not null]
  user_id varchar(24) [not null]
}

Table sessions {
  id varchar(24) [pk]
  session_id varchar(32) [unique, not null]
  user_id varchar(24) [not null]
  session_data varchar(2000) [not null]
  created_at datetime [not null]
  updated_at datetime
}

Table settings {
  id varchar(24) [pk]
  group varchar(50) [not null]
  key varchar(50) [unique, not null]
  value text
  type varchar(50) [not null]
  flags varchar(50)
  created_at datetime [not null]
  updated_at datetime
}

Table snippets {
  id varchar(24) [pk]
  name varchar(191) [unique, not null]
  mobiledoc longtext [not null]
  lexical longtext
  created_at datetime [not null]
  updated_at datetime
}

Table stripe_checkout_config {
  id varchar(24) [pk]
  slug varchar(191) [unique, not null]
