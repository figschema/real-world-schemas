  youtube varchar(191)
  instagram varchar(191)
  linkedin varchar(191)
  accessibility text
  status varchar(50) [not null]
  locale varchar(6)
  visibility varchar(50) [not null]
  meta_title varchar(2000)
  meta_description varchar(2000)
