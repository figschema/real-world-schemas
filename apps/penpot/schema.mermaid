%% Diagrammed with FigSchema
erDiagram
    access_token {
        uuid id PK
        uuid profile_id FK
        timestamp_with_time_zone created_at
        timestamp_with_time_zone updated_at
        text name
        text token
        text[] perms
        timestamp_with_time_zone expires_at
        text type
    }
    audit_log {
        uuid id PK
        text name
        text type
        timestamp_with_time_zone created_at
        timestamp_with_time_zone archived_at
        uuid profile_id
        jsonb props
        inet ip_addr
        timestamp_with_time_zone tracked_at
        text source
        jsonb context
    }
    comment {
        uuid id PK
        uuid thread_id FK
        uuid owner_id FK
        timestamp_with_time_zone created_at
        timestamp_with_time_zone modified_at
        text content
        uuid[] mentions
    }
    comment_thread {
        uuid id PK
        uuid file_id FK
        uuid owner_id FK
        timestamp_with_time_zone created_at
        timestamp_with_time_zone modified_at
        uuid page_id
        jsonb participants
        integer seqn
        point position
        boolean is_resolved
        text page_name
        uuid frame_id
        uuid[] mentions
    }
    comment_thread_status {
        uuid thread_id FK
        uuid profile_id FK
        timestamp_with_time_zone created_at
        timestamp_with_time_zone modified_at
    }
    file {
        uuid id PK
        uuid project_id FK
        timestamp_with_time_zone created_at
        timestamp_with_time_zone modified_at
        timestamp_with_time_zone deleted_at
        text name
        boolean is_shared
        boolean has_media_trimmed
        bigint revn
        bytea data
        timestamp_with_time_zone ignore_sync_until
        integer comment_thread_seqn
        text data_backend
        text[] features
        integer version
        integer vern
    }
    file_change {
        uuid id PK
        uuid file_id FK
        timestamp_with_time_zone created_at
        uuid session_id
        bigint revn
        bytea data
        bytea changes
        uuid profile_id FK
        text[] features
        text label
        text data_backend
        uuid data_ref_id
        integer version
        text created_by
        timestamp_with_time_zone updated_at
        timestamp_with_time_zone deleted_at
        uuid locked_by FK
        text[] migrations
    }
    file_data {
        uuid file_id FK
        uuid id
        timestamp_with_time_zone created_at
        timestamp_with_time_zone modified_at
        timestamp_with_time_zone deleted_at
        text type
        text backend
        jsonb metadata
        bytea data
    }
